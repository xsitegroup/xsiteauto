# ---------- required ----------
# Postgres connection string (Vercel adds this when you connect a Neon/Postgres database)
DATABASE_URL=
# Long random string used to sign logins and email codes. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Long random string. Vercel sends it to the nightly trial job (/api/cron/daily).
CRON_SECRET=

# ---------- addresses (defaults shown) ----------
APP_URL=https://app.xsiteauto.com
APP_HOST=app.xsiteauto.com
BOOK_HOST=book.xsiteauto.com
MARKETING_URL=https://xsiteauto.com
# Extra Shop Book addresses, comma separated (e.g. a vercel.app preview URL)
SHOP_HOSTS=
# Shop shown on an address that isn't in shop_domains (handy for preview URLs), e.g. demo-shop
DEFAULT_SHOP_SLUG=

# ---------- email ----------
# Built-in sender for trial shops and XSite's own emails (resend.com). Verify xsiteauto.com in Resend first.
RESEND_API_KEY=
PLATFORM_FROM=notifications@xsiteauto.com
# Where new-trial alerts, sales and the daily summary go
SALES_EMAIL=david@xsitegroup.ca
# Optional: one shop's own Microsoft 365 mailbox. Used only for the shop named in MS_MAIL_SHOP.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_FROM=
MS_MAIL_SHOP=

# ---------- trial signup ----------
# Cloudflare Turnstile spam check on the signup page (optional but recommended)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Calendar link for the free 15-minute setup call (Calendly, Microsoft Bookings, ...)
SETUP_CALL_URL=
# XSite Command: POSTs each new trial, sale and daily summary as JSON
COMMAND_WEBHOOK_URL=
COMMAND_WEBHOOK_TOKEN=
# TESTING ONLY: shows the email code on the signup page. Never set this in production.
SIGNUP_DEV_CODES=

# ---------- billing (stripe.com) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: prices made in Stripe instead of the built-in $99/month and $495 setup
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SETUP=
# on = let Stripe Tax add sales tax / GST / HST at checkout
STRIPE_TAX=
# on = delete an unconverted trial's data 30 days after it ends (otherwise it's closed and kept)
AUTO_DELETE_CLOSED=

# ---------- other ----------
GOOGLE_PLACES_API_KEY=
